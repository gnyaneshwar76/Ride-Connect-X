# Capture and tooling scratch — never publish.
# ride-logs and live hold real device logcat and route history from the
# rider's own rides; maps-apk holds third-party APKs; blender is bulk binary.
# All four are untracked, and were also un-ignored: one `git add .` would have
# pushed 800 MB including real route data to the remote.
tools/ride-logs/
tools/live/
tools/maps-apk/
tools/blender/

# The rider's private test tracker — kept on this computer only.
/Test-Tracker.md

# Laptop-reset backup of Claude's memory, council reports and chat history.
# Private (email, notes) and ~900 MB — never published.
/backup/

# Firebase project config. Not a secret in the strict sense — it ships inside
# every APK and its key is restricted server-side — but it names the project and
# this repository is public. It was untracked AND un-ignored, one `git add .`
# from being published.
google-services.json
docs/app-walkthrough.mp4

# Firebase CLI deploy cache
.firebase/

# Scratch space — stays on this computer, never published.
/temporary/
